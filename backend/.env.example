# Copy to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# GitHub OAuth (for "Login with GitHub" in the app)
# Create OAuth App: GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret
# Backend base URL (for OAuth redirect and webhook). Use ngrok for local webhook testing.
APP_URL=http://localhost:8000
# Deep link scheme for the Expo app (default leetplacards)
# AUTH_REDIRECT_SCHEME=leetplacards
# Optional: host for redirect URL if different (e.g. expo dev client)
# AUTH_REDIRECT_HOST=

# JWT secret (change in production)
JWT_SECRET=change-me-in-production
# JWT_EXPIRE_DAYS=30

# GitHub webhook secret (set the same in GitHub repo Settings -> Webhooks -> Add webhook -> Secret)
# Used to verify push events. If empty, webhook still works (dev only).
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Groq LLM (for generating placard summary/approach from code)
GROQ_API_KEY=your_groq_api_key

GROQ_MODEL=llama-3.1-70b-versatile

# LeetCode path prefix (default "LeetCode"). User can override when connecting repo.
# LEETCODE_PATH_PREFIX=LeetCode
