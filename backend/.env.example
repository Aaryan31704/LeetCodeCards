# Copy to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# GitHub OAuth (for "Login with GitHub" in the app)
# Create OAuth App: GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL must be {APP_URL}/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# Backend base URL (for OAuth redirect and webhook).
# Must be publicly reachable for GitHub webhooks; use ngrok for local testing.
APP_URL=http://localhost:8000

# Deep link scheme for the Expo app (default leetplacards)
# AUTH_REDIRECT_SCHEME=leetplacards
# Optional: host for redirect URL if different (e.g. expo dev client)
# AUTH_REDIRECT_HOST=
# Comma-separated URL schemes allowed to receive the login token.
# Defaults to the scheme above plus Expo's exp/exps/expo-development-client.
# ALLOWED_REDIRECT_SCHEMES=leetplacards,exp,exps,expo-development-client

# JWT secret. MUST be changed; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# JWT_EXPIRE_DAYS=30

# GitHub webhook secret (set the same in GitHub repo Settings -> Webhooks -> Add webhook -> Secret)
# Used to verify push events. If empty, all payloads are accepted (dev only).
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Groq LLM (for generating placard description/approach from code)
# Check https://console.groq.com/docs/deprecations before pinning a model.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# LeetCode path prefix (default "LeetCode"). User can override when connecting repo.
# LEETCODE_PATH_PREFIX=LeetCode

# Comma-separated CORS origins. Defaults to "*" (fine for the mobile app, which
# uses Bearer tokens); set explicit origins if you add a browser client.
# CORS_ALLOW_ORIGINS=https://your-web-app.com

# Set to true to include exception details in 500 responses. Never in production.
# DEBUG=false
